generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  COMPUTER
  NOTEBOOK
  MOBILE
  PRINTER
  CAMERA
  NVR
  SWITCH
  ROUTER
  SERVER
  SMART_TV
  IOT
  UNKNOWN
}

enum DeviceStatus {
  ONLINE
  OFFLINE
}

enum DeviceEventType {
  DEVICE_DISCOVERED
  IP_CHANGED
  HOSTNAME_CHANGED
  WENT_OFFLINE
  WENT_ONLINE
  LINK_DOWN
  LINK_UP
}

enum LinkStatus {
  UNKNOWN
  UP
  DOWN
}

model Device {
  id           String       @id @default(cuid())
  ip           String
  mac          String?      @unique
  /// Endereços IPv6 separados por vírgula (global primeiro, depois link-local), descobertos via NDP.
  ipv6         String?
  hostname     String?
  /// Apelido dado pelo usuário; tem prioridade sobre o hostname na exibição e nunca é sobrescrito pelo scan.
  alias        String?
  /// Quando true, o scan não altera o tipo (definido manualmente).
  typeLocked   Boolean      @default(false)
  notes        String?
  vendor       String?
  type         DeviceType   @default(UNKNOWN)
  os           String?
  loggedUser   String?
  status       DeviceStatus @default(ONLINE)
  openPorts    String?
  firstSeenAt  DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  events       DeviceEvent[]
  linksFrom    TopologyLink[] @relation("LinkFrom")
  linksTo      TopologyLink[] @relation("LinkTo")
  /// "Conectado a" definido pelo usuário (ex: switch ou roteador onde o cabo chega). Tem prioridade sobre
  /// a ligação descoberta via SNMP e sobre a presumida no mapa.
  uplinkId     String?
  uplink       Device?      @relation("Uplink", fields: [uplinkId], references: [id], onDelete: SetNull)
  downlinks    Device[]     @relation("Uplink")

  @@index([ip])
  @@index([status])
}

model DeviceEvent {
  id            String          @id @default(cuid())
  deviceId      String
  device        Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type          DeviceEventType
  message       String
  previousValue String?
  newValue      String?
  createdAt     DateTime        @default(now())

  @@index([deviceId])
  @@index([createdAt])
}

model ScanConfig {
  id              String   @id @default(cuid())
  cidr            String
  intervalMinutes Int?
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ScanRun {
  id            String    @id @default(cuid())
  cidr          String
  status        String    @default("RUNNING")
  devicesFound  Int       @default(0)
  newDevices    Int       @default(0)
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  error         String?
}

/// Ligação física/lógica entre dois dispositivos, criada manualmente e monitorada periodicamente.
model TopologyLink {
  id           String     @id @default(cuid())
  fromDeviceId String
  fromDevice   Device     @relation("LinkFrom", fields: [fromDeviceId], references: [id], onDelete: Cascade)
  toDeviceId   String
  toDevice     Device     @relation("LinkTo", fields: [toDeviceId], references: [id], onDelete: Cascade)
  label        String?
  status       LinkStatus @default(UNKNOWN)
  /// Checagens seguidas com falha; a ligação só cai após atingir o limite (evita alarme por um ping perdido).
  failures     Int        @default(0)
  /// Qual ponta não respondeu na última falha.
  downReason   String?
  latencyMs    Int?
  lastCheckAt  DateTime?
  lastChangeAt DateTime?
  createdAt    DateTime   @default(now())

  @@unique([fromDeviceId, toDeviceId])
}

/// Posição de um nó no mapa da topologia, arrastado pelo usuário. Relativa ao gateway (centro do mapa),
/// para continuar válida quando o mapa cresce. nodeId é o id do dispositivo ou "internet".
model MapPosition {
  nodeId    String   @id
  x         Float
  y         Float
  updatedAt DateTime @updatedAt
}

/// Perfil de acesso. ADMIN gerencia usuários e configurações; OPERATOR opera a rede (scans, ferramentas,
/// edição, IA); VIEWER só consulta. A tabela de permissões fica em src/lib/auth/permissions.ts.
enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

/// Usuário com acesso ao app (login). Senha guardada como hash scrypt com salt próprio.
model User {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  role           UserRole  @default(VIEWER)
  /// Desativado = não entra, e as sessões abertas param de valer na próxima requisição.
  active         Boolean   @default(true)
  /// Vai no cookie de sessão; incrementar (troca de senha, desativação) invalida as sessões já emitidas.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
}

/// Cache de respostas da IA (chave = hash da funcionalidade + entrada mascarada): evita pagar duas vezes pela mesma análise.
model AiCache {
  key       String   @id
  response  String
  createdAt DateTime @default(now())
}

/// Resumos de eventos gerados pela IA, exibidos no topo do Histórico.
model AiSummary {
  id        String   @id @default(cuid())
  /// "24h" ou "7d"
  period    String
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Configurações do app editáveis pela interface (chave → valor). Segredos são gravados criptografados.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Equipamento gerenciável via SNMP (switch, roteador...) cadastrado na página Equipamentos para
/// consulta do estado do hardware e das portas. A community é uma credencial: fica criptografada.
model Equipment {
  id          String   @id @default(cuid())
  name        String
  ip          String   @unique
  community   String
  /// "1", "2c" ou "3".
  snmpVersion String   @default("2c")
  /// Credenciais SNMPv3; os campos de senha são criptografados pela aplicação.
  snmpUsername      String?
  snmpAuthPassword  String?
  snmpAuthProtocol  String?
    snmpPrivPassword  String?
    snmpPrivProtocol  String?
  notes       String?
  /// Leitura automática na página de Equipamentos (minutos); null = desligada.
  pollIntervalMinutes Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
